{
    "install_specific_version": {
        "image": "ubuntu:22.04",
        "features": {
            "lilypond": {
                "version": "2.24.4"
            }
        }
    },
    "install_texlive_fonts_no_texlive": {
        "image": "ubuntu:22.04",
        "features": {
            "lilypond": {
                "texliveFonts": true
            }
        }
    },
    "alpine_source_build_with_texlive": {
        "image": "alpine:3.21",
        "features": {
            "ghcr.io/aiscgre-br/devcontainer-features/texlive": {
                "scheme": "minimal",
                "packages": "metapost"
            },
            "lilypond": {}
        }
    }
}
